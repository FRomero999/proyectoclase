<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <aside class="off-canvas hidden">
    <nav class="off-canvas-menu">
      <button class="off-canvas-close">&times;</button>
      <ul>
        <li><a href="/program/dam">DAM<br><small>Multiplatform Application Development</small></a></li>
        <li><a href="/program/daw">DAW<br><small>Web Application Developmen</small></a></li>
        <li><a href="/program/asir">ASIR<br><small>IT Systems Administration</small></a></li>
        <li><a href="/program/asrm">ASRM<br><small>Microcomputer Systems and Network</small></a></li>
      </ul>
    </nav>
    <footer>
      © CESUR 2024 — Inspiring the next generation of IT professionals.
    </footer>
  </aside>

  <section class="header">
    <nav class="header-navbar">
      <a href="/"><img src="/images/logo.png"></a>
      <ul>
        <li><a href="#about-us">About Us</a></li>
        <li><a href="#programs" id="open_offcanvas">Programs</a></li>
        <li><a href="#admissions">Admissions</a></li>
      </ul>
      <ul>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </section>

  <section class="hero">
    <video autoplay muted loop playsinline src="/images/background.mp4"></video>
    <!--div class="hero-overlay"></div-->
    <h1>Welcome to <span>CESUR</span></h1>
    <small>Informatics Vocational Training Center</small>
    <p>
      At CESUR, we shape tomorrow’s IT professionals today. Our center specializes in high-quality, hands-on training in programming, networks, cybersecurity, and web development. Learn from experienced teachers in a dynamic environment that fosters real-world skills, teamwork, and innovation. Start your pathway to an exciting tech career with us!
    </p>
  </section>

  <section class="courses">
    <h2>Our courses</h2>
    <div class="courses-inner">
      <% courses.forEach(element => { %>
        <a class="card-link" href="/program/<%= element.id %>">
          <div class="card">
            <img src="<%= element.image %>" alt="<%= element.alt %>">
            <div class="card-inner">
              <p><%= element.description %></p>
              <h4><%= element.title %></h4>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  </section>

  <section class="slideshow">
    <h2>Campus life</h2>
    <div class="slideshow-inner">
      <!-- Ventana visible: recorta todo lo que queda fuera del track -->
      <div class="slideshow-track">
        <div class="slide active">
          <img src="https://picsum.photos/id/1050/1200/500" alt="Students working on a project">
          <div class="slide-caption">
            <h4>Hands-on learning</h4>
            <p>Our students build real projects from day one, working in teams on the same tools used by the industry.</p>
          </div>
        </div>
        <div class="slide">
          <img src="https://picsum.photos/id/1060/1200/500" alt="Computer lab at CESUR">
          <div class="slide-caption">
            <h4>Modern facilities</h4>
            <p>Fully equipped computer labs, networking racks and server rooms where theory becomes practice.</p>
          </div>
        </div>
        <div class="slide">
          <img src="https://picsum.photos/id/1070/1200/500" alt="Students at a technology event">
          <div class="slide-caption">
            <h4>Industry connections</h4>
            <p>Workshops, hackathons and internships with local tech companies to launch your career.</p>
          </div>
        </div>
        <!-- Copia del primer slide: permite cerrar el bucle sin salto visible -->
        <div class="slide" aria-hidden="true">
          <img src="https://picsum.photos/id/1050/1200/500" alt="Students working on a project">
          <div class="slide-caption">
            <h4>Hands-on learning</h4>
            <p>Our students build real projects from day one, working in teams on the same tools used by the industry.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="facilities">
    <div class="facilities-inner">
      <% facilities.forEach(facility => { %>
        <div class="facilities-row <%= facility.reverse ? 'facilities-row--reverse' : '' %>">
          <div class="facilities-image">
            <img src="<%= facility.image %>" alt="<%= facility.alt %>">
          </div>
          <div class="facilities-text">
            <h2><%= facility.heading %></h2>
            <p><%= facility.description %></p>
            <ul>
              <% facility.items.forEach(item => { %>
                <li><%= item %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
  
  <section class="slideshow-fade">
    <h2>Student experiences</h2>
    <div class="slideshow-fade-inner">
      <!-- Los slides se apilan en el mismo espacio y se alternan con un fundido -->
      <div class="fade-slide">
        <img src="https://picsum.photos/id/1005/900/500" alt="Student testimonial">
        <div class="slide-caption">
          <p>"The hands-on projects helped me land my first developer job before finishing the course."</p>
          <h4>Laura Gómez — DAW graduate</h4>
        </div>
      </div>
      <div class="fade-slide">
        <img src="https://picsum.photos/id/1011/900/500" alt="Student testimonial">
        <div class="slide-caption">
          <p>"The teachers know the industry first-hand and guide you through every project."</p>
          <h4>Daniel Ruiz — DAM graduate</h4>
        </div>
      </div>
      <div class="fade-slide">
        <img src="https://picsum.photos/id/1027/900/500" alt="Student testimonial">
        <div class="slide-caption">
          <p>"I learned to manage real networks and servers, and I am now working as a systems technician."</p>
          <h4>Marta Sanz — ASIR graduate</h4>
        </div>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-inner-col">
        <h4>About CESUR</h4>
        <p>
          CESUR is a leading Vocational Training Center specializing in Informatics.<br>
          C. Technology Avenue, 12<br>
          Málaga, Spain<br>
          Phone: +34 951 123 456<br>
          Email: info@cesurfp.com
        </p>
      </div>
      <div class="footer-inner-col">
        <h4>Quick Links</h4>
        <ul>
          <li><a href="#about-us">About Us</a></li>
          <li><a href="#programs">Programs</a></li>
          <li><a href="#admissions">Admissions</a></li>
          <li><a href="#contact">Contact</a></li>
          <li><a href="#news">News & Events</a></li>
        </ul>
      </div>
      <div class="footer-inner-col">
        <h4>Follow Us</h4>
        <ul>
          <li><a href="https://www.facebook.com/cesurfp" target="_blank">Facebook</a></li>
          <li><a href="https://twitter.com/cesurfp" target="_blank">Twitter</a></li>
          <li><a href="https://www.linkedin.com/school/cesurfp/" target="_blank">LinkedIn</a></li>
          <li><a href="https://www.instagram.com/cesurfp/" target="_blank">Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-line">
        &copy; 2026 CESUR Informatics Vocational Training Center. All rights reserved. |
        <a href="#privacy-policy">Privacy Policy</a> |
        <a href="#legal-notice">Legal Notice</a> |
        <a href="#cookies-policy" id="cookies-link">Cookies Policy</a>
    </div>
  </footer>

  <div class="cookies-panel">
    <div class="inner">
      <p>This website uses cookies to improve your browsing experience. By continuing to use our site, you accept our use of cookies.</p>
      <div class="cookie-info">
        <h4>Lorem, ipsum dolor.</h4>
        <p>Lorem ipsum, dolor sit amet consectetur adipisicing elit. Dolorem inventore veritatis nihil eaque et sunt quis corrupti a eum rem quae, enim dolores iste deserunt voluptatibus sit veniam commodi ducimus.</p>
        <h4>Lorem ipsum dolor sit amet.</h4>
        <p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Hic sunt, omnis illo recusandae accusamus, nobis repellendus dicta eos dolores, ipsam impedit harum modi molestias debitis soluta natus vitae temporibus vero iste excepturi mollitia dignissimos neque. Ex minus repudiandae alias inventore.</p>

      </div>
    </div>
    <div class="inner">
      <button class="cookies-read">Read all info</button>
      <button class="cookies-accept">Accept all cookies</button>
    </div>
  </div>

  <script src="/javascripts/app.js"></script>

  </body>
</html>
