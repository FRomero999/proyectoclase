<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.title %> — CESUR</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <!--
      TODO: Convertir la cabezera y el aside en partials
  -->

  <aside class="off-canvas hidden">
    <nav class="off-canvas-menu">
      <button class="off-canvas-close">&times;</button>
      <ul>
        <li><a href="/program/dam">DAM<br><small>Multiplatform Application Development</small></a></li>
        <li><a href="/program/daw">DAW<br><small>Web Application Developmen</small></a></li>
        <li><a href="/program/asir">ASIR<br><small>IT Systems Administration</small></a></li>
        <li><a href="/program/asrm">ASRM<br><small>Microcomputer Systems and Network</small></a></li>
      </ul>
    </nav>
    <footer>
      © CESUR 2024 — Inspiring the next generation of IT professionals.
    </footer>
  </aside>

  <section class="header">
    <nav class="header-navbar">
      <img src="/images/logo.png">
      <ul>
        <li><a href="#about-us">About Us</a></li>
        <li><a href="#programs" id="open_offcanvas">Programs</a></li>
        <li><a href="#admissions">Admissions</a></li>
      </ul>
      <ul>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </section>

  <section class="hero course-hero" style="background-image: url('<%= course.image %>');">
    <h1><%= course.title %></h1>
    <small><%= course.id.toUpperCase() %> · 2 academic years</small>
    <p><%- course.description %></p>
  </section>


  <%# El footer y el panel de cookies viven en views/partials/footer.ejs %>
  <%- include('partials/footer') %>

  <script src="/javascripts/app.js"></script>

</body>
</html>
