<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= course.title %> — CESUR</title>
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

  <%- include('partials/offcanvas') %>

  <%- include('partials/header') %>

  <section class="hero course-hero" style="background-image: url('<%= course.image %>');">
    <h1><%= course.title %></h1>
    <small><%= course.id.toUpperCase() %> · 2 academic years</small>
    <p><%- course.description %></p>
  </section>


  <%# El footer y el panel de cookies viven en views/partials/footer.ejs %>
  <%- include('partials/footer') %>

  <script src="/javascripts/app.js"></script>

</body>
</html>
